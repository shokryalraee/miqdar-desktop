{
  "name": "miqdar-cashier",
  "productName": "مقدار كاشير",
  "version": "1.2.1",
  "description": "Miqdar Cashier — official Windows app: opens Miqdar and prints silently by printer name",
  "main": "main.js",
  "author": "Miqdar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/guard.test.js test/preload.test.js test/printing.test.js test/escpos.test.js test/updater.test.js test/agent.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish always",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdf-to-printer": "^5.8.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miqdarerp.cashier",
    "productName": "Miqdar Cashier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shokryalraee",
        "repo": "miqdar-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Miqdar-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Miqdar-${arch}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "artifactName": "Miqdar-${arch}.${ext}",
      "icon": "build/icon.icns"
    },
    "asarUnpack": [
      "node_modules/pdf-to-printer/**"
    ]
  }
}
