{
  "name": "miqdar-cashier",
  "productName": "مقدار كاشير",
  "version": "1.0.0",
  "description": "Miqdar Cashier — official Windows app: opens Miqdar and prints silently by printer name",
  "main": "main.js",
  "author": "Miqdar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/guard.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdf-to-printer": "^5.8.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miqdarerp.cashier",
    "productName": "Miqdar Cashier",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "lib/**", "package.json"],
    "publish": [{ "provider": "github", "owner": "shokryalraee", "repo": "miqdar-desktop", "releaseType": "release" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Miqdar-Cashier-Setup-${version}.exe" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
